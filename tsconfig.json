{
  "exclude": ["node_modules", "lib"],
  "compileOnSave": false,
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "outDir": "./lib",
    "strict": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "target": "ES2021",
    "module": "Node16",
    "importHelpers": false,
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "lib": ["ES2021"]
  }
}
